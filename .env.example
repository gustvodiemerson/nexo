# NEXO — variáveis de ambiente (todas opcionais)
PORT=3000
NODE_ENV=production
APP_URL=https://seu-dominio.com.br      # usado nos links de convite e recuperação de senha
TRUST_PROXY=1                           # atrás de proxy/HTTPS (Netlify, Render, Fly, nginx…)
DATA_DIR=./data                         # onde fica o banco SQLite (use volume persistente!)
APP_TZ=America/Sao_Paulo

RESEND_API_KEY=
MAIL_FROM="NEXO <no-reply@seu-dominio.com.br>"
# IA (nenhuma chave = modo local, só cálculos sobre seus dados)
AI_PROVIDER=anthropic,openai,gemini,groq,openrouter
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
