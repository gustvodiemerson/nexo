# NEXO — variáveis de ambiente
# Netlify: Site configuration → Environment variables.   Local: copie para .env e exporte.

# ---- obrigatória em produção ----
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (porta 6543). Troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=postgresql://postgres.xxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ---- recomendadas ----
APP_URL=https://SEU-SITE.netlify.app    # links de convite e recuperação de senha
APP_TZ=America/Sao_Paulo

# ---- opcionais ----
RESEND_API_KEY=
MAIL_FROM="NEXO <no-reply@seu-dominio.com.br>"
# IA (nenhuma chave = modo local, só cálculos sobre seus dados)
AI_PROVIDER=anthropic,openai,gemini,groq,openrouter
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=                          # recomendada: gratuita e lê notas fiscais por foto (aistudio.google.com)
# GEMINI_MODEL=gemini-2.5-flash
# VISION_TIMEOUT_MS=9000
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ---- só para rodar local ----
# Sem DATABASE_URL o app usa um Postgres embutido (PGlite) em ./data/pglite — não precisa instalar nada.
PORT=3000
DATA_DIR=./data

# --- Bancos (Pluggy / Open Finance, somente leitura) ---
# Crie uma aplicação em dashboard.pluggy.ai e coloque as chaves SÓ aqui (na Netlify marque "Contains secret values").
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# BANK_BACKFILL_DAYS=90   # quantos dias de extrato importar na primeira vez (7 a 365)
